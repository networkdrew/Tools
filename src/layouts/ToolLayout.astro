---
import type { ToolMeta } from "@/lib/tools/schema";
import { categories, getCategory } from "@/lib/tools/categories";
import { getRelatedTools } from "@/lib/tools/registry";
import BaseLayout from "./BaseLayout.astro";
import { ToolWorkspaceShell } from "@/components/react/ToolWorkspaceShell";

interface Props {
  tool: ToolMeta;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { tool, structuredData } = Astro.props;
const category = getCategory(tool.categoryId);
const related = getRelatedTools(tool);

const relatedTools = related.map((t) => ({
  slug: t.slug,
  name: t.name,
  categoryName: getCategory(t.categoryId)?.name,
}));

const categorySummaries = categories.map((c) => ({ id: c.id, name: c.name }));
---

<BaseLayout
  title={tool.name}
  description={tool.seo.description ?? tool.shortDescription}
  path={`/tools/${tool.slug}/`}
  structuredData={structuredData}
  chrome="none"
>
  <ToolWorkspaceShell
    client:load
    tool={{
      name: tool.name,
      shortDescription: tool.shortDescription,
      description: tool.description,
      usageNotes: tool.usageNotes,
      executionMode: tool.executionMode,
    }}
    category={category && { id: category.id, name: category.name }}
    categories={categorySummaries}
    relatedTools={relatedTools}
  >
    <slot />
  </ToolWorkspaceShell>
</BaseLayout>
